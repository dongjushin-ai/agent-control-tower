    "dashboard",
    "observability",
    "llm"
  ],
  "license": "MIT",
  "author": "DockY (https://github.com/dongjushin-ai)",
  "homepage": "https://github.com/dongjushin-ai/agent-control-tower#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongjushin-ai/agent-control-tower.git"
  },
  "bugs": "https://github.com/dongjushin-ai/agent-control-tower/issues",
  "bin": {
    "agent-control-tower": "bin/tower.mjs",
    "tower": "bin/tower.mjs"
  },
  "main": "dashboard/tower-core.js",
  "files": [
    "bin/",
    "dashboard/",
    "templates/",
    "snippets/",
